# Copia este archivo como ".env" (en la misma carpeta backend) y llena lo que quieras usar.
# Si no existe .env, todo funciona igual: los correos quedan sin enviar hasta configurarlos y WhatsApp queda como enlace de un toque.

PORT=3000
NAVI_INSTITUCION=Unidad Educativa N.A.V.I

# Modo demostracion: datos de ejemplo, cuenta demo, simulador del lector y reinicio del dia.
# Usa su propia base de datos (carpeta data-demo), separada de la real.
# Es mas facil abrir INICIAR_NAVI_DEMO.bat que cambiar esto.
NAVI_DEMO=0

# Dias que se guardan las fotos de la camara antes de borrarse solas.
NAVI_PHOTO_DAYS=7

# Tamano minimo (bytes) de una foto valida. Una foto mas pequena se considera camara tapada.
NAVI_CAM_MIN_BYTES=7000

# Correo: es mas facil configurarlo en la app (Ajustes -> Canales -> Correo). Esto es opcional.
# Con Gmail: activa la verificacion en 2 pasos y crea una "contrasena de aplicacion".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Telegram (gratis): es mas facil pegar el token en la app (Ajustes -> Canales -> Telegram). Esto es opcional.
TELEGRAM_BOT_TOKEN=

# Dirección pública para la ficha médica de emergencia que se graba en las tarjetas.
# Ejemplos: http://192.168.1.50:3000 (solo en el WiFi del colegio) o https://navi.tucolegio.edu.ec
# Si se deja vacío se usa la dirección con la que abriste la app.
NAVI_PUBLIC_URL=
